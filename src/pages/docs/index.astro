---
import { getCollection } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

const pages = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
---

<DocsLayout title="User guide" description="Learn how to install and use S.O.K to organize your media library.">
  <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-[var(--color-text)] mb-3">User guide</h1>
  <p class="text-lg text-[var(--color-secondary)] mb-10">
    Everything you need to install S.O.K and organize your media library. New here? Start with
    <a href="/docs/getting-started" class="text-[var(--color-text)] underline underline-offset-4">Getting started</a>.
  </p>

  <div class="grid gap-4 sm:grid-cols-2">
    {pages.map((page) => (
      <a
        href={`/docs/${page.id}`}
        class="glass-panel bg-[var(--color-card-bg)] rounded-[var(--radius-sm)] p-5 hover:bg-[var(--color-hover)] hover:scale-[1.01] transition-all duration-300"
      >
        <h2 class="font-semibold text-[var(--color-text)] mb-1">{page.data.title}</h2>
        <p class="text-sm text-[var(--color-secondary)]">{page.data.description}</p>
      </a>
    ))}
  </div>
</DocsLayout>
