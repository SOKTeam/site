---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';

export async function getStaticPaths() {
  const pages = await getCollection('guide');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<GuideLayout title={page.data.title} description={page.data.description} current={page.id}>
  <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-[var(--color-text)] mb-3">{page.data.title}</h1>
  <p class="text-lg text-[var(--color-secondary)] mb-10">{page.data.description}</p>
  <div class="doc-prose">
    <Content />
  </div>
</GuideLayout>
