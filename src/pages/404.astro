---
import Layout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { LANGUAGES, localize } from '../i18n/config';
import { t } from '../i18n';

// One page for every unknown address: English here, then the script shows
// the texts of the language of the address asked (/fr/… → French).
const text = t('en').notFound;
const texts = Object.fromEntries(
  LANGUAGES.map((lang) => [
    lang,
    { ...t(lang).notFound, homeHref: localize('/', lang), guideHref: localize('/guide', lang) },
  ]),
);
---

<Layout title={text.title} description={text.description} noindex>
  <div class="pt-32 pb-24 md:pt-40">
    <div class="container mx-auto px-4 text-center max-w-xl">
      <p class="text-7xl md:text-8xl font-bold tracking-tight text-[var(--color-text)] mb-4">404</p>
      <h1 id="nf-heading" class="text-2xl md:text-3xl font-bold mb-4 text-[var(--color-text)]">{text.heading}</h1>
      <p id="nf-text" class="text-[var(--color-secondary)] md:text-lg mb-10">
        {text.text}
      </p>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-4">
        <Button href="/" variant="primary" id="nf-home">{text.home}</Button>
        <Button href="/guide" variant="secondary" id="nf-guide">{text.guide}</Button>
      </div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ texts }}>
  const lang = location.pathname.split('/')[1];
  const text = texts[lang];
  if (text && lang !== 'en') {
    document.documentElement.lang = lang;
    document.title = text.title;
    document.getElementById('nf-heading').textContent = text.heading;
    document.getElementById('nf-text').textContent = text.text;
    const home = document.getElementById('nf-home');
    home.textContent = text.home;
    home.setAttribute('href', text.homeHref);
    const guide = document.getElementById('nf-guide');
    guide.textContent = text.guide;
    guide.setAttribute('href', text.guideHref);
  }
</script>
