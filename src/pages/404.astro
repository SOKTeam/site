---
import Layout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<Layout title="Page not found - S.O.K" description="This page does not exist." noindex>
  <div class="pt-32 pb-24 md:pt-40">
    <div class="container mx-auto px-4 text-center max-w-xl">
      <p class="text-7xl md:text-8xl font-bold tracking-tight text-[var(--color-text)] mb-4">404</p>
      <h1 class="text-2xl md:text-3xl font-bold mb-4 text-[var(--color-text)]">This file got lost in the mess</h1>
      <p class="text-[var(--color-secondary)] md:text-lg mb-10">
        The page you are looking for does not exist or has moved. Even S.O.K can't organize what isn't there.
      </p>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-4">
        <Button href="/" variant="primary">Back to home</Button>
        <Button href="/docs" variant="secondary">Read the guide</Button>
      </div>
    </div>
  </div>
</Layout>
