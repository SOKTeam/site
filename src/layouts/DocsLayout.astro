---
import { getCollection } from 'astro:content';
import Layout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  // id of the current doc page; undefined on the docs home page
  current?: string;
}

const { title, description, current } = Astro.props;

const pages = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const index = pages.findIndex((page) => page.id === current);
const prev = index > 0 ? pages[index - 1] : undefined;
const next = index >= 0 && index < pages.length - 1 ? pages[index + 1] : undefined;

const links = [
  { href: '/docs', title: 'Overview', active: current === undefined },
  ...pages.map((page) => ({ href: `/docs/${page.id}`, title: page.data.title, active: page.id === current })),
];
const currentTitle = links.find((link) => link.active)?.title;

const linkClass = (active: boolean) => [
  "block px-3 py-2 text-sm rounded-lg",
  active
    ? "bg-[var(--color-hover)] text-[var(--color-text)] font-semibold"
    : "text-[var(--color-secondary)] hover:bg-[var(--color-hover)] hover:text-[var(--color-text)]",
];
---

<Layout title={`${title} - S.O.K Docs`} description={description}>
  <div class="pt-20 md:pt-28 pb-16 md:pb-20">
    <div class="container mx-auto px-4 max-w-6xl flex flex-col md:flex-row gap-6 md:gap-12">
      <!-- Sidebar: collapsible on phones, sticky column from md up -->
      <aside class="md:w-56 shrink-0">
        <details class="md:hidden glass-panel rounded-[var(--radius-sm)] bg-[var(--color-card-bg)] group">
          <summary class="flex items-center justify-between gap-3 px-4 py-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="min-w-0">
              <span class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-tertiary)]">User guide</span>
              <span class="block truncate font-semibold text-[var(--color-text)]">{currentTitle}</span>
            </span>
            <svg class="w-5 h-5 shrink-0 text-[var(--color-text)] transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </summary>
          <div class="px-3 pb-3">
            <ul class="space-y-1">
              {links.map((link) => (
                <li>
                  <a href={link.href} aria-current={link.active ? 'page' : undefined} class:list={linkClass(link.active)}>
                    {link.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </details>

        <nav class="hidden md:block md:sticky md:top-24 glass-panel rounded-[var(--radius-sm)] p-3 bg-[var(--color-card-bg)]">
          <ul class="space-y-1">
            {links.map((link) => (
              <li>
                <a href={link.href} aria-current={link.active ? 'page' : undefined} class:list={linkClass(link.active)}>
                  {link.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>

      <!-- Content -->
      <article class="flex-1 min-w-0">
        <slot />

        {(prev || next) && (
          <nav class="mt-12 md:mt-16 pt-8 border-t border-[var(--color-separator)] grid grid-cols-2 gap-4">
            <div>
              {prev && (
                <a href={`/docs/${prev.id}`} class="group block">
                  <span class="text-xs text-[var(--color-tertiary)]">← Previous</span>
                  <span class="block font-semibold text-[var(--color-text)] group-hover:underline">{prev.data.title}</span>
                </a>
              )}
            </div>
            <div class="text-right">
              {next && (
                <a href={`/docs/${next.id}`} class="group block">
                  <span class="text-xs text-[var(--color-tertiary)]">Next →</span>
                  <span class="block font-semibold text-[var(--color-text)] group-hover:underline">{next.data.title}</span>
                </a>
              )}
            </div>
          </nav>
        )}
      </article>
    </div>
  </div>
</Layout>

<style is:global>
  .doc-prose {
    color: var(--color-secondary);
    line-height: 1.7;
  }
  .doc-prose > * + * {
    margin-top: 1rem;
  }
  .doc-prose h2 {
    margin-top: 2.5rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    scroll-margin-top: 6rem;
  }
  .doc-prose h3 {
    margin-top: 1.75rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    scroll-margin-top: 6rem;
  }
  .doc-prose strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .doc-prose a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .doc-prose a:hover {
    opacity: 0.8;
  }
  .doc-prose ul {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .doc-prose ol {
    list-style: decimal;
    padding-left: 1.5rem;
  }
  .doc-prose li + li,
  .doc-prose li > ul {
    margin-top: 0.375rem;
  }
  .doc-prose code {
    font-size: 0.875em;
    padding: 0.125rem 0.375rem;
    border-radius: 6px;
    background: var(--color-input-bg);
    color: var(--color-text);
  }
  .doc-prose pre {
    padding: 1rem 1.25rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-separator);
    background: var(--color-card-bg) !important;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .doc-prose pre code {
    padding: 0;
    background: none;
  }
  .doc-prose blockquote {
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--color-text);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--color-card-bg);
  }
  .doc-prose table {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .doc-prose th,
  .doc-prose td {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--color-separator);
    text-align: left;
    vertical-align: top;
  }
  .doc-prose td:first-child {
    min-width: 7rem;
  }
  .doc-prose th {
    color: var(--color-text);
    font-weight: 600;
  }
</style>
