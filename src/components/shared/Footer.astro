---
import { langOf, localize } from '../../i18n/config';
import { t } from '../../i18n';

const year = new Date().getFullYear();
const lang = langOf(Astro.url.pathname);
const text = t(lang).footer;
---

<footer class="border-t border-[var(--color-separator)] bg-[var(--color-bg)] py-8 mt-auto">
  <div class="container mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-2">
      <span class="text-xl font-bold text-[var(--color-text)]">S.O.K</span>
      <span class="text-sm text-[var(--color-tertiary)]">© {year} Storage Organisation Kit</span>
    </div>
    
    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
      <a href={localize("/guide", lang)} class="text-sm text-[var(--color-tertiary)] hover:text-[var(--color-text)] transition-colors">
        {text.guide}
      </a>
      <a href="/docs" class="text-sm text-[var(--color-tertiary)] hover:text-[var(--color-text)] transition-colors">
        {text.docs}
      </a>
      <a href={localize("/releases", lang)} class="text-sm text-[var(--color-tertiary)] hover:text-[var(--color-text)] transition-colors">
        {text.releases}
      </a>
      <a href="https://github.com/SOKTeam/S.O.K" class="text-sm text-[var(--color-tertiary)] hover:text-[var(--color-text)] transition-colors">
        GitHub
      </a>
      <a href="https://github.com/SOKTeam/S.O.K/blob/main/LICENSE" class="text-sm text-[var(--color-tertiary)] hover:text-[var(--color-text)] transition-colors">
        {text.license}
      </a>
    </div>
  </div>
</footer>
