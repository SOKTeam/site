---
import { langOf, localize } from '../../i18n/config';
import { t } from '../../i18n';

interface Props {
  // "desktop": inline links in the header; "mobile": stacked links in the menu panel
  variant?: 'desktop' | 'mobile';
}

const { variant = 'desktop' } = Astro.props;

const lang = langOf(Astro.url.pathname);
const text = t(lang).nav;
const links = [
  { href: "/", label: text.home },
  { href: "/features", label: text.features },
  { href: "/guide", label: text.guide },
  { href: "/docs", label: text.docs },
  { href: "/roadmap", label: text.roadmap },
  { href: "/download", label: text.download },
].map((link) => ({ ...link, href: localize(link.href, lang) }));
---

{variant === 'desktop' ? (
  <nav class="hidden lg:flex items-center gap-6">
    {links.map((link) => (
      <a
        href={link.href}
        class="text-sm font-medium whitespace-nowrap text-[var(--color-text)] hover:text-[var(--color-secondary)] transition-colors"
      >
        {link.label}
      </a>
    ))}
  </nav>
) : (
  <nav class="flex flex-col">
    {links.map((link) => (
      <a
        href={link.href}
        class="px-2 py-3 text-right text-lg font-semibold text-[var(--color-text)] border-b border-[var(--color-separator)] last:border-b-0"
      >
        {link.label}
      </a>
    ))}
  </nav>
)}
