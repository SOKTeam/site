---
import Navigation from "./Navigation.astro";
import Button from "../ui/Button.astro";
import ThemeToggle from "./ThemeToggle.astro";
import logoImg from "../../assets/logo.svg";
---

<header
  class="fixed top-0 z-50 w-full bg-[var(--color-bg)]/70 backdrop-blur-xl border-b border-[var(--color-separator)] transition-all duration-300"
>
  <div
    class="container mx-auto px-4 sm:px-6 h-14 md:h-16 grid grid-cols-2 md:grid-cols-3 items-center"
  >
    <!-- Logo (Left) -->
    <div class="flex items-center justify-start">
      <a
        href="/"
        class="text-xl font-bold tracking-tight text-[var(--color-text)] hover:opacity-80 transition-opacity flex items-center gap-3"
      >
        <img
          loading="eager"
          src={logoImg.src}
          alt="S.O.K Logo"
          width="32"
          height="32"
          class="w-8 h-8"
        />
        <span>S.O.K</span>
      </a>
    </div>

    <!-- Navigation (Center) - Hidden on mobile -->
    <div class="hidden md:flex justify-center">
      <Navigation />
    </div>

    <!-- Actions (Right) -->
    <div class="flex items-center justify-end gap-1 sm:gap-3">
      <ThemeToggle />

      <!-- GitHub Icon Button -->
      <a
        href="https://github.com/SOKTeam/S.O.K"
        target="_blank"
        rel="noopener noreferrer"
        class="w-9 h-9 flex items-center justify-center rounded-full text-[var(--color-text)] hover:bg-[var(--color-text)] hover:text-[var(--color-bg)] transition-all duration-300"
        aria-label="GitHub"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          ><path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path></svg
        >
      </a>

      <!-- Mini Download Button (wrapped so `hidden` isn't overridden by the button's inline-flex) -->
      <div class="hidden sm:block">
        <Button href="/download" variant="primary" size="sm" class="text-xs px-4 h-8">
          Download
        </Button>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="group md:hidden relative w-10 h-10 flex items-center justify-center rounded-full text-[var(--color-text)] hover:bg-[var(--color-hover)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg class="absolute w-6 h-6 transition-[opacity,rotate] duration-500 ease-out group-aria-expanded:opacity-0 group-aria-expanded:rotate-90" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
        <svg class="absolute w-6 h-6 opacity-0 -rotate-90 transition-[opacity,rotate] duration-500 ease-out group-aria-expanded:opacity-100 group-aria-expanded:rotate-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Panel -->
  <div
    id="mobile-menu"
    class="group/menu md:hidden grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-500 ease-out data-open:grid-rows-[1fr] data-open:opacity-100 motion-reduce:transition-none"
    inert
  >
    <div class="overflow-hidden">
      <div class="border-t border-[var(--color-separator)] bg-[var(--color-bg)] max-h-[calc(100dvh-3.5rem)] overflow-y-auto">
        <div class="container mx-auto px-4 py-2 -translate-y-2 transition-transform duration-500 ease-out group-data-open/menu:translate-y-0 motion-reduce:transition-none">
          <Navigation variant="mobile" />
          <div class="py-4">
            <Button href="/download" variant="primary" size="md" class="w-full">
              Download S.O.K
            </Button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");

  const setOpen = (open: boolean) => {
    menu?.toggleAttribute("data-open", open);
    if (menu) menu.inert = !open;
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  };

  toggle?.addEventListener("click", () => setOpen(!menu?.hasAttribute("data-open")));
  // Close after picking a link (covers same-page anchors like /#features)
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
  // Reset when growing past the md breakpoint
  window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });
</script>
