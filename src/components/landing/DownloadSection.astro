---
import Button from '../ui/Button.astro';
import { getLatestRelease } from '../../lib/release.js';

// Import OS logos as raw SVGs for monochrome styling
import WindowsLogo from '../../assets/Windows.svg?raw';
import AppleLogo from '../../assets/Apple.svg?raw';
import LinuxLogo from '../../assets/Linux.svg?raw';
import DockerLogo from '../../assets/Docker.svg?raw';

import { langOf, localize } from '../../i18n/config';
import { fill, t } from '../../i18n';

// Pulled from the latest GitHub release at build time.
const release = await getLatestRelease();
const lang = langOf(Astro.url.pathname);
const text = t(lang).downloadSection;
---

<section class="py-24 bg-[var(--color-bg)] border-t border-[var(--color-separator)]">
  <div class="container mx-auto px-6 text-center">
    <h2 class="text-4xl md:text-5xl font-bold mb-8 text-[var(--color-text)] tracking-tight">{text.title}</h2>
    <p class="text-xl text-[var(--color-secondary)] mb-12 max-w-2xl mx-auto font-medium">
      {text.text1} <br class="hidden md:block" />
      {text.text2}
    </p>
    
    <div class="flex flex-col items-center gap-8">
      <Button href={localize("/download", lang)} variant="primary" size="lg" class="min-w-[240px]">
        {text.button}
      </Button>

      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 opacity-50">
        <div class="flex items-center gap-2 text-sm font-semibold text-[var(--color-text)]" title={fill(text.availableFor, { os: "Windows" })}>
          <div class="w-5 h-5 fill-current" set:html={WindowsLogo} />
          <span>Windows</span>
        </div>
        <div class="flex items-center gap-2 text-sm font-semibold text-[var(--color-text)]" title={fill(text.availableFor, { os: "macOS" })}>
          <div class="w-5 h-5 fill-current" set:html={AppleLogo} />
          <span>macOS</span>
        </div>
        <div class="flex items-center gap-2 text-sm font-semibold text-[var(--color-text)]" title={fill(text.availableFor, { os: "Linux" })}>
          <div class="w-5 h-5 fill-current" set:html={LinuxLogo} />
          <span>Linux</span>
        </div>
        <a href={localize("/guide/server", lang)} class="flex items-center gap-2 text-sm font-semibold text-[var(--color-text)] hover:opacity-80 transition-opacity" title={text.dockerTitle}>
          <div class="w-5 h-5 fill-current" set:html={DockerLogo} />
          <span>Docker</span>
        </a>
      </div>
    </div>

    <p class="mt-12 text-sm text-[var(--color-tertiary)] font-medium">
      {fill(text.footer, { version: release.version })}
    </p>
  </div>
</section>