---
import logo from "../../assets/logo.svg";

// Reproduction of the S.O.K home page as each system shows it. Windows and
// Linux share the frameless window with a custom title bar; macOS keeps the
// native window (traffic lights) and a Finder-like sidebar. The visitor's
// system is picked before the first paint; the switcher shows the others.

// Icons of the app (src/sok/resources/assets), drawn with currentColor.
const icons = {
    home: '<svg viewBox="0 0 16 16" fill="none"><path d="M8 1L1.5 6.5V14.5H5.5V10.5C5.5 9.67157 6.17157 9 7 9H9C9.82843 9 10.5 9.67157 10.5 10.5V14.5H14.5V6.5L8 1Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    video: '<svg viewBox="0 0 24 24" fill="none"><rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 9L15 12L10 15V9Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    music: '<svg viewBox="0 0 24 24" fill="none"><path d="M9 18V5L21 3V16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="2"/><circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="2"/></svg>',
    book: '<svg viewBox="0 0 24 24" fill="none"><path d="M12 10.4V20M12 10.4C12 8.16 12 7.04 11.564 6.184C11.18 5.431 10.569 4.819 9.816 4.436C8.96 4 7.84 4 5.6 4H4.6C4.04 4 3.76 4 3.546 4.109C3.358 4.205 3.205 4.358 3.109 4.546C3 4.76 3 5.04 3 5.6V16.4C3 16.96 3 17.24 3.109 17.454C3.205 17.642 3.358 17.795 3.546 17.891C3.76 18 4.04 18 4.6 18H7.547C8.087 18 8.357 18 8.618 18.047C8.85 18.088 9.076 18.156 9.292 18.251C9.535 18.357 9.76 18.507 10.209 18.806L12 20M12 10.4C12 8.16 12 7.04 12.436 6.184C12.82 5.431 13.431 4.819 14.184 4.436C15.04 4 16.16 4 18.4 4H19.4C19.96 4 20.24 4 20.454 4.109C20.642 4.205 20.795 4.358 20.891 4.546C21 4.76 21 5.04 21 5.6V16.4C21 16.96 21 17.24 20.891 17.454C20.795 17.642 20.642 17.795 20.454 17.891C20.24 18 19.96 18 19.4 18H16.453C15.913 18 15.643 18 15.382 18.047C15.15 18.088 14.924 18.156 14.708 18.251C14.465 18.357 14.24 18.507 13.791 18.806L12 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    game: '<svg viewBox="0 0 24 24" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M12.75 6V3.75H11.25V6L9 6C6.10051 6 3.75 8.3505 3.75 11.25V17.909C3.75 19.2019 4.7981 20.25 6.09099 20.25C6.71186 20.25 7.3073 20.0034 7.74632 19.5643L10.8107 16.5H13.1893L16.2537 19.5643C16.6927 20.0034 17.2881 20.25 17.909 20.25C19.2019 20.25 20.25 19.2019 20.25 17.909V11.25C20.25 8.3505 17.8995 6 15 6L12.75 6ZM18.75 11.25C18.75 9.17893 17.0711 7.5 15 7.5L9 7.5C6.92893 7.5 5.25 9.17893 5.25 11.25V17.909C5.25 18.3735 5.62652 18.75 6.09099 18.75C6.31403 18.75 6.52794 18.6614 6.68566 18.5037L10.1893 15H13.8107L17.3143 18.5037C17.4721 18.6614 17.686 18.75 17.909 18.75C18.3735 18.75 18.75 18.3735 18.75 17.909V11.25ZM6.75 12.75V11.25H8.25V9.75H9.75V11.25H11.25V12.75H9.75V14.25H8.25V12.75H6.75ZM15 10.875C15 11.4963 14.4963 12 13.875 12C13.2537 12 12.75 11.4963 12.75 10.875C12.75 10.2537 13.2537 9.75 13.875 9.75C14.4963 9.75 15 10.2537 15 10.875ZM16.125 14.25C16.7463 14.25 17.25 13.7463 17.25 13.125C17.25 12.5037 16.7463 12 16.125 12C15.5037 12 15 12.5037 15 13.125C15 13.7463 15.5037 14.25 16.125 14.25Z" fill="currentColor"/></svg>',
    settings: '<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M13.765 2.152C13.398 2 12.932 2 12 2C11.068 2 10.602 2 10.235 2.152C9.745 2.355 9.355 2.745 9.152 3.235C9.06 3.458 9.023 3.719 9.009 4.098C8.988 4.656 8.702 5.172 8.219 5.451C7.736 5.73 7.146 5.72 6.652 5.459C6.316 5.281 6.073 5.183 5.833 5.151C5.307 5.082 4.775 5.224 4.354 5.547C4.039 5.789 3.806 6.193 3.34 7C2.874 7.807 2.641 8.21 2.589 8.605C2.52 9.131 2.662 9.663 2.985 10.084C3.133 10.276 3.34 10.437 3.661 10.639C4.134 10.936 4.438 11.442 4.438 12C4.438 12.558 4.134 13.064 3.661 13.361C3.34 13.563 3.132 13.724 2.985 13.917C2.662 14.337 2.52 14.869 2.589 15.395C2.641 15.789 2.874 16.193 3.34 17C3.806 17.807 4.039 18.211 4.354 18.453C4.775 18.776 5.307 18.918 5.833 18.849C6.073 18.817 6.316 18.719 6.652 18.541C7.145 18.28 7.736 18.27 8.219 18.549C8.702 18.828 8.988 19.344 9.009 19.902C9.023 20.282 9.06 20.542 9.152 20.765C9.355 21.255 9.745 21.645 10.235 21.848C10.602 22 11.068 22 12 22C12.932 22 13.398 22 13.765 21.848C14.255 21.645 14.645 21.255 14.848 20.765C14.94 20.542 14.977 20.282 14.991 19.902C15.012 19.344 15.298 18.828 15.781 18.549C16.264 18.27 16.854 18.28 17.348 18.541C17.684 18.719 17.927 18.817 18.167 18.849C18.693 18.918 19.225 18.776 19.646 18.453C19.961 18.211 20.194 17.807 20.66 17C21.126 16.193 21.359 15.789 21.411 15.395C21.48 14.869 21.338 14.337 21.015 13.916C20.867 13.724 20.66 13.563 20.339 13.361C19.866 13.064 19.562 12.558 19.562 12C19.562 11.442 19.866 10.936 20.339 10.639C20.66 10.437 20.868 10.276 21.015 10.084C21.338 9.663 21.48 9.131 21.411 8.605C21.359 8.211 21.126 7.807 20.66 7C20.194 6.193 19.961 5.789 19.646 5.547C19.225 5.224 18.693 5.082 18.167 5.151C17.927 5.183 17.684 5.281 17.348 5.459C16.855 5.72 16.264 5.73 15.781 5.451C15.298 5.172 15.012 4.656 14.991 4.098C14.977 3.718 14.94 3.458 14.848 3.235C14.645 2.745 14.255 2.355 13.765 2.152Z" stroke="currentColor" stroke-width="1.5"/></svg>',
    menu: '<svg viewBox="0 0 24 24" fill="none"><path d="M4 6H20M4 12H20M4 18H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
};

const library = [
    { label: "Home", icon: "home", active: true },
    { label: "TV Shows", icon: "video" },
    { label: "Movies", icon: "video" },
    { label: "Music", icon: "music" },
    { label: "Books", icon: "book" },
    { label: "Games", icon: "game" },
];

const quickAccess = [
    { title: "TV Shows", sub: "Organize TV shows", icon: "video" },
    { title: "Movies", sub: "Batch rename movies", icon: "video" },
    { title: "Music", sub: "Tag your Albums", icon: "music" },
    { title: "Books", sub: "Manage your Ebooks", icon: "book" },
    { title: "Games", sub: "Organize your ROMs", icon: "game" },
];

// Drive names as each system reports them. The icon color follows the free
// space with the app's fixed colors: green above 20%, orange above 10%.
const drives = [
    { names: { windows: "Drive C", mac: "Macintosh HD", linux: "System" }, free: "212 GB Free", color: "#50FA7B" },
    { names: { windows: "Drive D", mac: "Media", linux: "Media" }, free: "86 GB Free", color: "#FFB86C" },
];

const systems = [
    { id: "windows", label: "Windows" },
    { id: "mac", label: "macOS" },
    { id: "linux", label: "Linux" },
];
---

<section class="py-16 md:py-32 relative overflow-x-clip bg-gradient-to-b from-transparent via-[var(--color-text)]/5 to-transparent">

    <!-- Background Stage Effect (Glow behind the window) -->
    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-[120%] bg-[radial-gradient(circle,var(--color-accent)_0%,transparent_70%)] blur-[120px]"></div>
    </div>

    <div class="container mx-auto px-4 sm:px-8 lg:px-12 relative z-10">
        <div id="sok-showcase" class="sok-app relative w-full max-w-6xl mx-auto transition-all duration-1000 hover:scale-[1.01] hover:-translate-y-3 group" data-os="windows">

          <!-- Outer glow, visible on hover -->
          <div class="absolute -inset-4 bg-black/5 dark:bg-[var(--color-accent)]/10 blur-[60px] -z-10 translate-y-12 opacity-0 group-hover:opacity-100 transition-all duration-1000"></div>

          <!-- Window -->
          <div class="app-window overflow-hidden relative z-10 transition-colors duration-300" role="img" aria-label="Preview of the S.O.K home page">
            <div class="flex md:h-[640px] relative">

              <!-- Sidebar -->
              <div class="app-sidebar w-[220px] shrink-0 flex-col pb-3 hidden md:flex">

                <!-- macOS: traffic lights and the sidebar toggle -->
                <div class="mac-only h-[38px] items-center gap-2 pl-4">
                    <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span>
                    <span class="w-3 h-3 rounded-full bg-[#FEBC2E]"></span>
                    <span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
                    <span class="ml-auto mr-[62px] w-[16px] h-[12px] rounded-[3px] border-[1.5px] border-[var(--app-icon)] relative">
                        <span class="absolute left-[4px] top-0 bottom-0 border-l-[1.5px] border-[var(--app-icon)]"></span>
                    </span>
                </div>

                <!-- Windows / Linux: menu button -->
                <div class="win-only px-3 pt-1 pb-3">
                    <div class="flex-1 h-10 rounded-[6px] bg-[var(--app-menu-bg)] flex items-center px-3 text-[var(--app-icon)]">
                        <span class="w-[18px] h-[18px] [&>svg]:w-full [&>svg]:h-full" set:html={icons.menu} />
                    </div>
                </div>

                <div class="app-heading">Library</div>
                {library.map((item) => (
                    <div class:list={["app-nav-item", { active: item.active }]}>
                        <span class="app-nav-icon [&>svg]:w-full [&>svg]:h-full" set:html={icons[item.icon]} />
                        {item.label}
                    </div>
                ))}

                <div class="mt-auto">
                    <div class="app-heading">General</div>
                    <div class="app-nav-item">
                        <span class="app-nav-icon [&>svg]:w-full [&>svg]:h-full" set:html={icons.settings} />
                        Settings
                    </div>
                </div>
              </div>

              <!-- Main area -->
              <div class="flex-1 min-w-0 flex flex-col bg-[var(--app-bg)]">

                <!-- Title bar: Windows / Linux -->
                <div class="win-only h-[42px] shrink-0 items-center justify-between pl-4 sm:pl-7">
                    <div class="flex items-center gap-3">
                        <img loading="lazy" src={logo.src} alt="" class="w-5 h-5">
                        <span class="text-[13px] font-semibold text-[var(--app-text)]">S.O.K - Home</span>
                    </div>
                    <div class="flex h-full text-[var(--app-text)]">
                        <div class="w-11 h-full flex items-center justify-center hover:bg-[var(--app-hover)] transition-colors">
                            <svg width="10" height="1" viewBox="0 0 10 1"><rect width="10" height="1" fill="currentColor"/></svg>
                        </div>
                        <div class="w-11 h-full flex items-center justify-center hover:bg-[var(--app-hover)] transition-colors">
                            <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><rect x="0.5" y="0.5" width="9" height="9" rx="1" stroke="currentColor"/></svg>
                        </div>
                        <div class="w-11 h-full flex items-center justify-center hover:bg-[#E81123] hover:text-white transition-colors">
                            <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1 1L9 9M9 1L1 9" stroke="currentColor" stroke-width="1.2"/></svg>
                        </div>
                    </div>
                </div>

                <!-- Title bar: macOS (title centered over the content) -->
                <div class="mac-only relative h-[38px] shrink-0 items-center justify-center">
                    <!-- Traffic lights move here when the sidebar is hidden (phones) -->
                    <div class="md:hidden absolute left-4 flex gap-2">
                        <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span>
                        <span class="w-3 h-3 rounded-full bg-[#FEBC2E]"></span>
                        <span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
                    </div>
                    <span class="text-[13px] font-semibold text-[var(--app-text)]">Home</span>
                </div>

                <div class="flex-1 min-h-0 overflow-hidden px-4 sm:px-7 pb-6">

                    <!-- Welcome header -->
                    <div class="mb-6 sm:mb-8 flex items-start justify-between gap-4">
                        <div class="pt-1">
                            <h2 class="text-[22px] sm:text-[26px] font-bold text-[var(--app-text)] mb-2 leading-tight">Welcome to S.O.K</h2>
                            <p class="text-[13px] text-[var(--app-secondary)]">Storage Organisation Kit - Your media library, perfectly organized.</p>
                        </div>
                        <img loading="lazy" src={logo.src} alt="" class="w-14 h-14 sm:w-[72px] sm:h-[72px] shrink-0">
                    </div>

                    <!-- Drive monitors -->
                    <div class="app-section">Drive Monitors</div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6 sm:mb-8">
                        {drives.map((drive) => (
                            <div class="app-stat flex items-center gap-4 rounded-[12px] p-4 sm:p-5">
                                <div class="w-12 h-12 rounded-[12px] bg-[var(--app-input)] flex items-center justify-center shrink-0" style={`color: ${drive.color}`}>
                                    <span class="w-6 h-6 [&>svg]:w-full [&>svg]:h-full" set:html={icons.settings} />
                                </div>
                                <div class="min-w-0">
                                    <p class="text-[13px] text-[var(--app-secondary)] truncate">
                                        <span class="os-windows">{drive.names.windows}</span>
                                        <span class="os-mac">{drive.names.mac}</span>
                                        <span class="os-linux">{drive.names.linux}</span>
                                    </p>
                                    <p class="text-[20px] sm:text-[22px] font-bold text-[var(--app-text)] leading-tight">{drive.free}</p>
                                </div>
                            </div>
                        ))}
                    </div>

                    <!-- Quick access: three cards, then two -->
                    <div class="app-section">Quick Access</div>
                    <div class="grid grid-cols-2 lg:grid-cols-6 gap-4">
                        {quickAccess.map((item, index) => (
                            <div class:list={["app-card rounded-[12px] p-5 flex flex-col items-start gap-3 cursor-default", index < 3 ? "lg:col-span-2" : "lg:col-span-3"]}>
                                <div class="w-10 h-10 rounded-full bg-[var(--app-accent)] text-[var(--app-accent-text)] flex items-center justify-center">
                                    <span class="w-5 h-5 [&>svg]:w-full [&>svg]:h-full" set:html={icons[item.icon]} />
                                </div>
                                <div>
                                    <h3 class="text-[15px] sm:text-[16px] font-bold text-[var(--app-text)]">{item.title}</h3>
                                    <p class="text-[12px] sm:text-[13px] text-[var(--app-secondary)]">{item.sub}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Ambient Glow -->
          <div class="absolute -top-20 -right-20 w-[500px] h-[500px] dark:bg-[var(--color-accent)] bg-[var(--color-accent-text)] rounded-full blur-[120px] opacity-10 -z-10 animate-pulse-slow"></div>
        </div>

        <!-- System switcher -->
        <div class="mt-8 flex justify-center">
            <div class="inline-flex gap-1 p-1 rounded-full bg-[var(--color-text)]/5 border border-[var(--color-separator)]" role="group" aria-label="Show S.O.K as it looks on">
                {systems.map((system) => (
                    <button type="button" class="os-switch px-4 py-1.5 rounded-full text-[13px] font-medium text-[var(--color-secondary)] hover:text-[var(--color-text)] transition-colors" data-os-choice={system.id} aria-pressed="false">
                        {system.label}
                    </button>
                ))}
            </div>
        </div>
    </div>
</section>

<script is:inline>
    // Show the visitor's system before the first paint, then let the switcher
    // change it. Phones and unknown systems keep Windows, the default.
    (function () {
        var root = document.getElementById('sok-showcase');
        var buttons = document.querySelectorAll('.os-switch');
        function show(os) {
            root.dataset.os = os;
            buttons.forEach(function (b) {
                b.setAttribute('aria-pressed', String(b.dataset.osChoice === os));
            });
        }
        var platform = ((navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || '') + ' ' + navigator.userAgent;
        var os = 'windows';
        if (/Mac|iPhone|iPad/i.test(platform)) os = 'mac';
        else if (/Linux|X11|CrOS/i.test(platform) && !/Android/i.test(platform)) os = 'linux';
        show(os);
        buttons.forEach(function (b) {
            b.addEventListener('click', function () { show(b.dataset.osChoice); });
        });
    })();
</script>

<style>
    /* Inter is the font S.O.K bundles on Linux; browsers only download it
       when the Linux view is shown. */
    @font-face {
        font-family: "SOK Inter";
        src: url("/fonts/Inter-Regular.woff2") format("woff2");
        font-weight: 400;
        font-display: swap;
    }
    @font-face {
        font-family: "SOK Inter";
        src: url("/fonts/Inter-SemiBold.woff2") format("woff2");
        font-weight: 500 600;
        font-display: swap;
    }
    @font-face {
        font-family: "SOK Inter";
        src: url("/fonts/Inter-Bold.woff2") format("woff2");
        font-weight: 700;
        font-display: swap;
    }

    /* App palettes (src/sok/ui/theme.py). The site's orange theme maps to
       the app's light theme: orange on Windows and Linux, white on macOS. */
    .sok-app {
        --app-bg: #FB6048;
        --app-sidebar: #FB6048;
        --app-card: #FB6048;
        --app-stat: rgba(255, 255, 255, 0.15);
        --app-text: #FFFFFF;
        --app-secondary: rgba(255, 255, 255, 0.9);
        --app-accent: #FFFFFF;
        --app-accent-text: #FB6048;
        --app-separator: rgba(255, 255, 255, 0.3);
        --app-hover: rgba(255, 255, 255, 0.3);
        --app-input: rgba(255, 255, 255, 0.25);
        --app-icon: #FFFFFF;
        --app-menu-bg: rgba(255, 255, 255, 0.3);
        --app-selection: rgba(255, 255, 255, 0.1);
        --app-active-text: #FB6048;
        font-family: "Segoe UI Variable Text", "Segoe UI Variable", "Segoe UI", system-ui, sans-serif;
    }
    .sok-app[data-os="mac"] {
        --app-bg: #FFFFFF;
        --app-sidebar: #EDEDF0;
        --app-card: #F5F5F7;
        --app-stat: #F5F5F7;
        --app-text: #1D1D1F;
        --app-secondary: #6E6E73;
        --app-accent: #FB6048;
        --app-accent-text: #FFFFFF;
        --app-separator: #E3E3E8;
        --app-hover: rgba(0, 0, 0, 0.06);
        --app-input: #FFFFFF;
        --app-icon: #6E6E73;
        --app-selection: rgba(0, 0, 0, 0.1);
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, sans-serif;
    }
    .sok-app[data-os="linux"] {
        font-family: "SOK Inter", system-ui, sans-serif;
    }
    :global(.dark) .sok-app {
        --app-bg: #121212;
        --app-sidebar: #1E1E1E;
        --app-card: #1E1E1E;
        --app-stat: #1E1E1E;
        --app-text: #FFFFFF;
        --app-secondary: #B3B3B3;
        --app-accent: #FB6048;
        --app-accent-text: #FFFFFF;
        --app-separator: #333333;
        --app-hover: rgba(255, 255, 255, 0.1);
        --app-input: #2C2C2E;
        --app-icon: #B3B3B3;
        --app-menu-bg: #2C2C2E;
        --app-selection: rgba(255, 255, 255, 0.1);
        --app-active-text: #FFFFFF;
    }

    .app-window {
        background: var(--app-bg);
        border-radius: 12px;
        box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(255, 255, 255, 0.2);
    }
    :global(.dark) .app-window {
        box-shadow: 0 40px 80px -15px rgba(0, 0, 0, 0.8), 0 0 20px -5px rgba(251, 96, 72, 0.2), 0 0 0 1px rgba(255, 255, 255, 0.1);
    }
    .sok-app[data-os="mac"] .app-window {
        border-radius: 10px;
    }

    .app-sidebar {
        background: var(--app-sidebar);
        border-right: 1px solid var(--app-separator);
    }

    /* One title bar and one set of drive names at a time */
    .mac-only, .os-mac, .os-linux {
        display: none;
    }
    .win-only {
        display: flex;
    }
    .sok-app[data-os="mac"] .mac-only {
        display: flex;
    }
    .sok-app[data-os="mac"] .win-only,
    .sok-app[data-os="mac"] .os-windows,
    .sok-app[data-os="linux"] .os-windows {
        display: none;
    }
    .sok-app[data-os="mac"] .os-mac,
    .sok-app[data-os="linux"] .os-linux {
        display: inline;
    }

    /* Sidebar: Windows 11 style rows and uppercase headings */
    .app-heading {
        padding: 10px 24px 6px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--app-secondary);
    }
    .app-nav-item {
        display: flex;
        align-items: center;
        gap: 14px;
        height: 40px;
        margin: 4px 12px;
        padding: 0 8px;
        border-radius: 6px;
        font-size: 15px;
        color: var(--app-text);
    }
    .app-nav-icon {
        width: 18px;
        height: 18px;
        color: var(--app-icon);
    }
    .app-nav-item.active,
    .app-nav-item.active .app-nav-icon {
        background: var(--app-accent);
        color: var(--app-active-text);
    }

    /* macOS: Finder sidebar */
