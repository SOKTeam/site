---
import Layout from '../layouts/BaseLayout.astro';
import { getLatestRelease } from '../lib/release.js';
import { softwareApplicationSchema } from '../lib/seo.js';

// Import OS logos as raw SVGs for monochrome styling
import WindowsLogo from '../assets/Windows.svg?raw';
import AppleLogo from '../assets/Apple.svg?raw';
import LinuxLogo from '../assets/Linux.svg?raw';
import DockerLogo from '../assets/Docker.svg?raw';

import { langOf, localize } from '../i18n/config';
import { fill, rich, t } from '../i18n';

// Pulled from the latest GitHub release at build time.
const release = await getLatestRelease();
const lang = langOf(Astro.url.pathname);
const text = t(lang).download;
const version = fill(text.version, { version: release.version });
---

<Layout
  title={release.linux ? text.titleAll : text.titleNoLinux}
  description={fill(text.description, { version: release.version, linux: release.linux ? text.descriptionLinux : '' })}
  jsonLd={softwareApplicationSchema(release, Astro.site, lang)}
>
  <div class="pt-32 pb-20">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6 text-[var(--color-text)] tracking-tight">{text.heading}</h1>
      <p class="text-xl text-[var(--color-secondary)] mb-16 max-w-2xl mx-auto">
        {text.intro1} <br />
        {text.intro2}
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 max-w-7xl mx-auto mb-20">
        
        <!-- Windows (Active) -->
        <div class="glass-panel p-8 rounded-[var(--radius-default)] flex flex-col items-center hover:scale-[1.02] transition-transform duration-300">
           <div class="w-16 h-16 mb-6 flex items-center justify-center rounded-full bg-[var(--color-text)]/5 text-[var(--color-text)]">
             <!-- Windows Icon -->
             <div class="w-8 h-8 fill-current [&>svg]:w-full [&>svg]:h-full" set:html={WindowsLogo} />
           </div>
           <h3 class="text-2xl font-bold mb-2 text-[var(--color-text)]">Windows</h3>
           <p class="text-sm text-[var(--color-secondary)] mb-8">{text.windowsVersions}</p>
           
           <div class="w-full flex-1 flex flex-col justify-center">
             <a href={release.windows.url} class="w-full py-3 px-6 bg-[var(--color-text)] text-[var(--color-bg)] rounded-full font-bold text-center hover:opacity-90 transition-opacity shadow-lg shadow-[var(--color-text)]/20">
               {text.downloadExe}
             </a>
             <p class="mt-4 text-xs text-[var(--color-tertiary)]">{version} • {release.windows.size}</p>
           </div>
        </div>

        <!-- macOS (Active once the release ships a .dmg) -->
        <div class:list={[
          'glass-panel p-8 rounded-[var(--radius-default)] flex flex-col items-center',
          release.macos ? 'hover:scale-[1.02] transition-transform duration-300' : 'opacity-60',
        ]}>
           <div class="w-16 h-16 mb-6 flex items-center justify-center rounded-full bg-[var(--color-text)]/5 text-[var(--color-text)]">
             <!-- Apple Icon -->
             <div class="w-10 h-10 fill-current [&>svg]:w-full [&>svg]:h-full translate-y-[-1px]" set:html={AppleLogo} />
           </div>
           <h3 class="text-2xl font-bold mb-2 text-[var(--color-text)]">macOS</h3>
           <p class="text-sm text-[var(--color-secondary)] mb-8">{text.macVersions}</p>

           <div class="w-full flex-1 flex flex-col justify-center">
             {release.macos ? (
               <>
                 <a href={release.macos.url} class="w-full py-3 px-6 bg-[var(--color-text)] text-[var(--color-bg)] rounded-full font-bold text-center hover:opacity-90 transition-opacity shadow-lg shadow-[var(--color-text)]/20">
                   {text.downloadDmg}
                 </a>
                 <p class="mt-4 text-xs text-[var(--color-tertiary)]">{version} • {release.macos.size}</p>
               </>
             ) : (
               <button disabled class="w-full py-3 px-6 bg-[var(--color-separator)] text-[var(--color-secondary)] rounded-full font-medium cursor-not-allowed border border-[var(--color-separator)]">
                 {text.comingSoon}
               </button>
             )}
           </div>
        </div>

        <!-- Linux (Active once the release ships the AppImages) -->
        <div class:list={[
          'glass-panel p-8 rounded-[var(--radius-default)] flex flex-col items-center',
          release.linux ? 'hover:scale-[1.02] transition-transform duration-300' : 'opacity-60',
        ]}>
           <div class="w-16 h-16 mb-6 flex items-center justify-center rounded-full bg-[var(--color-text)]/5 text-[var(--color-text)]">
             <!-- Linux Icon -->
             <div class="w-10 h-10 fill-current [&>svg]:w-full [&>svg]:h-full" set:html={LinuxLogo} />
           </div>
           <h3 class="text-2xl font-bold mb-2 text-[var(--color-text)]">Linux</h3>
           <p class="text-sm text-[var(--color-secondary)] mb-8">{text.linuxVersions}</p>

           <div class="w-full flex-1 flex flex-col justify-center">
             {release.linux ? (
               <div class="w-full flex flex-col gap-3">
                 {release.linux.x86_64 && (
                   <a href={release.linux.x86_64.url} class="w-full py-3 px-6 bg-[var(--color-text)] text-[var(--color-bg)] rounded-full font-bold text-center hover:opacity-90 transition-opacity shadow-lg shadow-[var(--color-text)]/20">
                     {text.appImageIntel}
                   </a>
                 )}
                 {release.linux.aarch64 && (
                   <a href={release.linux.aarch64.url} class="w-full py-3 px-6 bg-[var(--color-text)] text-[var(--color-bg)] rounded-full font-bold text-center hover:opacity-90 transition-opacity shadow-lg shadow-[var(--color-text)]/20">
                     {text.appImageArm}
                   </a>
                 )}
                 <p class="mt-1 text-xs text-[var(--color-tertiary)]">
                   {version} • {(release.linux.x86_64 ?? release.linux.aarch64).size}
                 </p>
               </div>
             ) : (
               <button disabled class="w-full py-3 px-6 bg-[var(--color-separator)] text-[var(--color-secondary)] rounded-full font-medium cursor-not-allowed border border-[var(--color-separator)]">
                 {text.comingSoon}
               </button>
             )}
           </div>
        </div>

        <!-- Docker: S.O.K Server, same version as the apps -->
        <div class="glass-panel p-8 rounded-[var(--radius-default)] flex flex-col items-center hover:scale-[1.02] transition-transform duration-300">
           <div class="w-16 h-16 mb-6 flex items-center justify-center rounded-full bg-[var(--color-text)]/5 text-[var(--color-text)]">
             <!-- Docker Icon -->
             <div class="w-10 h-10 fill-current [&>svg]:w-full [&>svg]:h-full" set:html={DockerLogo} />
           </div>
           <h3 class="text-2xl font-bold mb-2 text-[var(--color-text)]">Docker</h3>
           <p class="text-sm text-[var(--color-secondary)] mb-8">{text.dockerVersions}</p>

           <div class="w-full flex-1 flex flex-col justify-center gap-3">
             <button
               type="button"
               data-copy="docker pull ghcr.io/sokteam/sok-server"
               class="copy-command w-full py-2.5 px-4 rounded-2xl bg-[var(--color-text)]/10 text-[var(--color-text)] font-mono text-xs text-left hover:bg-[var(--color-text)]/15 transition-colors"
               title={text.copy}
             >
               <span class="block">docker pull</span>
               <span class="block">ghcr.io/sokteam/sok-server</span>
               <span class="copy-label block mt-1 font-sans text-[var(--color-tertiary)]" data-idle={text.clickToCopy} data-done={text.copied} data-failed={text.copyFailed}>{text.clickToCopy}</span>
             </button>
             <a href={localize("/guide/server", lang)} class="w-full py-3 px-6 bg-[var(--color-text)] text-[var(--color-bg)] rounded-full font-bold text-center hover:opacity-90 transition-opacity shadow-lg shadow-[var(--color-text)]/20">
               {text.installGuide}
             </a>
             <a href={localize("/demo", lang)} class="text-sm font-semibold text-[var(--color-text)] underline underline-offset-4 hover:opacity-80 transition-opacity">
               {text.tryDemo}
             </a>
             <p class="mt-1 text-xs text-[var(--color-tertiary)]">{version} • amd64, arm64</p>
           </div>
        </div>

      </div>

      <p class="text-sm text-[var(--color-secondary)] mb-4 max-w-2xl mx-auto">
        <Fragment set:html={rich(text.macNote, lang, "underline hover:text-[var(--color-text)] transition-colors")} />
      </p>
      {release.linux && (
        <p class="text-sm text-[var(--color-secondary)] mb-4 max-w-2xl mx-auto">
          <Fragment set:html={rich(text.linuxNote, lang, "underline hover:text-[var(--color-text)] transition-colors")} />
        </p>
      )}
      <p class="text-sm text-[var(--color-secondary)]">
        <Fragment set:html={rich(text.archiveNote, lang, "underline hover:text-[var(--color-text)] transition-colors")} />
      </p>
    </div>
  </div>
</Layout>

<script>
  // The docker command of the Docker card, copied with one click.
  for (const button of document.querySelectorAll<HTMLButtonElement>(".copy-command")) {
    button.addEventListener("click", async () => {
      const label = button.querySelector(".copy-label");
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        if (label) label.textContent = (label as HTMLElement).dataset.done ?? "";
      } catch {
        if (label) label.textContent = (label as HTMLElement).dataset.failed ?? "";
      }
      setTimeout(() => {
        if (label) label.textContent = (label as HTMLElement).dataset.idle ?? "";
      }, 2000);
    });
  }
</script>
