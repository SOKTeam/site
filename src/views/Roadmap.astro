---
import Layout from "../layouts/BaseLayout.astro";
import { langOf } from "../i18n/config";
import { t } from "../i18n";

const text = t(langOf(Astro.url.pathname)).roadmap;
// Same content as the Roadmap section of the S.O.K README.
const stages = [
  {
    title: text.available,
    dot: "bg-[var(--color-green)]",
    items: text.availableItems,
  },
  {
    title: text.next,
    dot: "bg-[var(--color-bg)] border-2 border-[var(--color-accent)]",
    items: text.nextItems,
  },
  {
    title: text.later,
    dot: "bg-[var(--color-bg)] border-2 border-[var(--color-tertiary)]",
    items: text.laterItems,
  },
];---

<Layout
  title={text.title}
  description={text.description}
>
  <div class="pt-32 pb-20">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold mb-12 text-center text-[var(--color-text)]">
        {text.heading}
      </h1>

      <div class="max-w-3xl mx-auto space-y-8">
        {
          stages.map((stage) => (
            <div class="relative pl-8 border-l-2 border-[var(--color-separator)]">
              <div
                class={`absolute -left-[9px] top-0 w-4 h-4 rounded-full ${stage.dot}`}
              />
              <h3 class="text-xl font-bold text-[var(--color-text)] mb-2">
                {stage.title}
              </h3>
              {stage.intro && (
                <p class="text-[var(--color-secondary)] mb-2">{stage.intro}</p>
              )}
              <ul class="list-disc pl-5 space-y-1 text-[var(--color-secondary)]">
                {stage.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
