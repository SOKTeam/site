---
import { render } from 'astro:content';
import GuideLayout from '../layouts/GuideLayout.astro';
import type { GuidePage } from '../lib/guide';

interface Props {
  page: GuidePage;
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<GuideLayout title={page.data.title} description={page.data.description} current={page.slug}>
  <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-[var(--color-text)] mb-3">{page.data.title}</h1>
  <p class="text-lg text-[var(--color-secondary)] mb-10">{page.data.description}</p>
  <div class="doc-prose">
    <Content />
  </div>
</GuideLayout>
