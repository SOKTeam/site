---
import Layout from '../layouts/BaseLayout.astro';
import { getAllReleases } from '../lib/release.js';

import { langOf, LOCALES } from '../i18n/config';
import { fill, rich, t } from '../i18n';

// Pulled from the GitHub releases list at build time.
const releases = await getAllReleases();
const lang = langOf(Astro.url.pathname);
const text = t(lang).releases;

const dateFormatter = new Intl.DateTimeFormat(LOCALES[lang], {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formatDate = (iso) => (iso ? dateFormatter.format(new Date(iso)) : '');
---

<Layout
  title={text.title}
  description={text.description}
>
  <div class="pt-32 pb-20">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-center text-[var(--color-text)] tracking-tight">
        {text.heading}
      </h1>
      <p class="text-lg text-[var(--color-secondary)] mb-16 text-center max-w-2xl mx-auto">
        <Fragment set:html={rich(text.intro, lang, "underline hover:text-[var(--color-text)] transition-colors")} />
      </p>

      {releases.length === 0 ? (
        <p class="text-center text-[var(--color-secondary)]">
          <Fragment set:html={rich(text.unavailable, lang, "underline hover:text-[var(--color-text)] transition-colors")} />
        </p>
      ) : (
        <div class="max-w-3xl mx-auto space-y-4">
          {releases.map((release, index) => (
            <div class="glass-panel p-6 rounded-[var(--radius-default)] flex flex-col sm:flex-row sm:items-center gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-3 flex-wrap">
                  <h2 class="text-xl font-bold text-[var(--color-text)]">
                    {fill(text.version, { version: release.version })}
                  </h2>
                  {index === 0 && (
                    <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded-full bg-[var(--color-green)]/15 text-[var(--color-green)]">
                      {text.latest}
                    </span>
                  )}
                </div>
                <p class="text-sm text-[var(--color-tertiary)] mt-1">
                  {formatDate(release.date)}
                </p>
                <a
                  href={release.notesUrl}
                  class="text-sm text-[var(--color-secondary)] underline hover:text-[var(--color-text)] transition-colors mt-1 inline-block"
                >
                  {text.notes}
                </a>
              </div>

              {release.windows || release.macos || release.linux ? (
                <div class="shrink-0 flex flex-col sm:items-end gap-2">
                  {release.windows && (
                    <a
                      href={release.windows.url}
                      class="py-2.5 px-5 bg-[var(--color-text)] text-[var(--color-bg)] rounded-full font-bold text-center text-sm hover:opacity-90 transition-opacity"
                    >
                      Windows .exe <span class="font-medium opacity-70">• {release.windows.size}</span>
                    </a>
                  )}
                  {release.macos && (
                    <a
                      href={release.macos.url}
                      class="py-2.5 px-5 bg-[var(--color-text)] text-[var(--color-bg)] rounded-full font-bold text-center text-sm hover:opacity-90 transition-opacity"
                    >
                      macOS .dmg <span class="font-medium opacity-70">• {release.macos.size}</span>
                    </a>
                  )}
                  {release.linux?.x86_64 && (
                    <a
                      href={release.linux.x86_64.url}
                      class="py-2.5 px-5 bg-[var(--color-text)] text-[var(--color-bg)] rounded-full font-bold text-center text-sm hover:opacity-90 transition-opacity"
                    >
                      Linux Intel/AMD <span class="font-medium opacity-70">• {release.linux.x86_64.size}</span>
                    </a>
                  )}
                  {release.linux?.aarch64 && (
                    <a
                      href={release.linux.aarch64.url}
                      class="py-2.5 px-5 bg-[var(--color-text)] text-[var(--color-bg)] rounded-full font-bold text-center text-sm hover:opacity-90 transition-opacity"
                    >
                      Linux ARM <span class="font-medium opacity-70">• {release.linux.aarch64.size}</span>
                    </a>
                  )}
                </div>
              ) : (
                <span class="shrink-0 py-2.5 px-5 text-sm text-[var(--color-tertiary)] border border-[var(--color-separator)] rounded-full">
                  {text.noInstaller}
                </span>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</Layout>
